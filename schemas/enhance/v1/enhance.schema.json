{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Egoushka/whetstone/schemas/enhance/v1/enhance.schema.json",
  "title": "enhance/v1",
  "description": "The enhance tool: a prompt in, a better prompt (or the same one) out. A pass-through is a valid answer.",
  "type": "object",
  "required": ["request", "response"],
  "additionalProperties": false,
  "properties": {
    "request": { "$ref": "#/$defs/request" },
    "response": { "$ref": "#/$defs/response" }
  },
  "$defs": {
    "request": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
            "task_kind": { "type": "string" },
            "client": { "type": "string" },
            "session_id": { "type": "string", "minLength": 1, "maxLength": 128, "description": "An opaque id the client chooses for the session; requests that share it share a session." },
            "hints": {
              "type": "object",
              "description": "Values for a template's hint slots ({{hint_<name>}}), such as the failing test path from the last CI run. Used for this answer, not stored.",
              "maxProperties": 10,
              "propertyNames": { "pattern": "^[a-z0-9_]{1,40}$" },
              "additionalProperties": { "type": "string", "maxLength": 500 }
            },
            "level": { "enum": ["cheap", "middle", "best"], "description": "The price level the client chose (a prompt prefix, a budget); a kind may have a champion per level." },
            "ablation": { "type": "string", "minLength": 1, "maxLength": 128, "description": "What the client held out for this session, such as rule:<id> or skill:<name>@<version>; stored so outcomes can be compared per ablation." }
          }
        },
        "deadline_ms": { "type": "integer", "minimum": 50, "maximum": 30000, "default": 1500 }
      }
    },
    "response": {
      "type": "object",
      "required": ["prompt", "changed", "template_id", "template_version", "reason", "request_id", "held_out"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "changed": { "type": "boolean" },
        "template_id": { "type": ["string", "null"] },
        "template_version": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "task_kind": { "type": ["string", "null"] },
        "request_id": { "type": "string", "minLength": 1 },
        "held_out": { "type": "boolean" },
        "source_request_id": { "type": "string", "minLength": 1, "description": "The stored request a retrieval drew on; left out when there was none." }
      }
    }
  }
}
