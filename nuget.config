<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: a restore must not depend on, or send requests to, any feed from the machine's own configuration. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
